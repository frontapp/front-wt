{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["unicorn", "import", "node"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "env": {
    "node": true,
    "es2024": true
  },
  "ignorePatterns": ["dist"],
  "rules": {
    "eqeqeq": "error",
    "no-console": "off",
    "no-control-regex": "off",
    "no-empty": "off",
    "no-shadow": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/no-array-sort": "off"
  }
}
